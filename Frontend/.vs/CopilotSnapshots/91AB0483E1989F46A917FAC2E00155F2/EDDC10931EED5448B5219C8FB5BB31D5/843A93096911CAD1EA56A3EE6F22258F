namespace MauiApp1.viewModel
{
        public enum TaskMode
        {
            ADD,
            DONE,
            PATCH
        };
    public partial class GoalsViewModel:ObservableObject
    {
        string? id;
        int trash = 0;

        [ObservableProperty]
        ICommand taskBtn;

        [ObservableProperty]
        public TaskMode? taskName= TaskMode.ADD;

        bool forColor= true;
        List<string> totalTasks = new List<string>();


        [ObservableProperty]
        bool addBtnVisible = false;

        [ObservableProperty]
        string btnText= "+ Add Goals";

        [ObservableProperty]
        bool isEditing = false;

        UserTasks currentTasks;
        int totalTask = 0;
        UserTasks updatedUserData = new();

        [ObservableProperty]
        ObservableCollection<TaskList> borderContext= new();

         updateData postApi = new updateData();
        public const string auth_token = "auth_token";

        [RelayCommand]
        public async Task addingTasks()
        {
            Debug.WriteLine("addingTasks command run");
                //TaskBtn= addMoreTasksCommand;
                var apiForRetrieve = new retrieveData();
                 currentTasks = await apiForRetrieve.retrieveUserTasks();
            BorderContext.Clear();

            foreach (var task in currentTasks.Tasks)
            {
                BorderContext.Add(new TaskList
                {
                    Goal = task,
                    BgColor = "Transparent"
                });
            }
        }

        [RelayCommand]
        public void addMoreTasks()
        {
            IsEditing = true;
            AddBtnVisible = true;
            TaskName = TaskMode.DONE;

        }
        [RelayCommand]
        public void addOneMoreTask()
        {
            BorderContext.Add(new TaskList { Goal = "" });

        }

        [RelayCommand]
        public async void deleteTask(TaskList task)
        {
            BorderContext.Remove(task);
            totalTasks.Clear();

            foreach (var item in BorderContext)
            {
                totalTasks.Add(item.Goal!);
            }
           
            updatedUserData.Tasks = totalTasks;
            await postApi.updateUserInfo(updatedUserData);

        }

        [RelayCommand]
        public void markAsCompleted(TaskList task)
        {

            task.BgColor = task.BgColor == "transparent" ? "LightGreen" : "transparent";
            foreach (var item in BorderContext)
            {
                if (item.BgColor == "LightGreen")
                {
                  TaskName= TaskMode.PATCH;
                    forColor = false;
                }
            }
            if (forColor)
            {
                TaskName = TaskMode.ADD;
            }
                forColor= true;
        }
        [RelayCommand]
        public async  void updateCompletedTask()
        {
            
                totalTasks.Clear();

                foreach (var item in BorderContext)
                {
                    if(item.bgColor == "LightGreen")
                    {
                        totalTasks.Add(item.Goal!);
                        Debug.WriteLine("wht the hellly");
                        BorderContext.Remove(item);
                    }

                }
                updatedUserData.Tasks = totalTasks;
                await postApi.updateUserInfo(updatedUserData);
        }

        [RelayCommand]
        public async Task addedMoreTasks()
        {
            trash = 0;
            foreach (var item in BorderContext)
            {
                if (string.IsNullOrWhiteSpace(item.Goal))
                {
                   trash++;
                   await Application.Current.MainPage.DisplayAlert("error", "please fill up all tasks", "OK");
                }
            }
            if (trash == 0)
            {

                TaskName = TaskMode.ADD;

                AddBtnVisible = false;

                IsEditing = false;


                totalTasks.Clear();

                foreach (var item  in BorderContext)
                {
                    totalTasks.Add(item.Goal!);
                }
                    updatedUserData.Tasks = totalTasks;
                await postApi.updateUserInfo(updatedUserData);
            }

        }


    
        public partial class TaskList: ObservableObject
        {
            [ObservableProperty]
            public string? goal;



            [ObservableProperty]
            public string? bgColor;

        }

    }

}
