using models.Dtos;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Net.Http.Headers;
using System.Net.Http.Json;
using System.Text;
using System.Text.Json;
using System.Threading.Tasks;

namespace MauiApp1.apiCalls
{
    internal class retrieveData
    {
        public readonly HttpClient _httpClient;
        public const string auth_token = "auth_token";
        public retrieveData()
        {
            _httpClient = new HttpClient { BaseAddress = new Uri("http://localhost:5000/") };
        }
        public async Task<UserTasks> retrieveUserTasks()
        {
            string token = await SecureStorage.GetAsync(auth_token);
            if (!string.IsNullOrEmpty(token))
            {
                Console.WriteLine("preeetS");
                Console.WriteLine(token);
                // Only at initialization, before any requests
                _httpClient.DefaultRequestHeaders.Authorization =
                    new AuthenticationHeaderValue("Bearer", token);
            }
            HttpResponseMessage response = await _httpClient.GetAsync("api/users/me");

            var body = await response.Content.ReadAsStringAsync();
            Console.WriteLine(response.StatusCode);
            Console.WriteLine(body);

            UserTasks userResponse = await response.Content.ReadFromJsonAsync<UserTasks>();



            return userResponse;
        }

    }
}
