<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pet"
             BackgroundColor="#F6F4FF">
    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="#6B5BFF"
                Padding="24,50,24,26">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="{Binding PetName}"
                           TextColor="White"
                           FontSize="26"
                           FontAttributes="Bold"/>
                    <Label Text="Your cheerful companion is waiting for you."
                           TextColor="White"
                           Opacity="0.9"
                           FontSize="13"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#FFF2D8"
                        Padding="14,8"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="🌱"
                               FontSize="18"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding PetLevel, StringFormat='Lv. {0}'}"
                               TextColor="#6B5BFF"
                               FontAttributes="Bold"
                               FontSize="13"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              RowDefinitions="*,Auto"
              Padding="20,24,20,20">

            <Border Grid.Row="0"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.10" Radius="16" Offset="0,6"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      RowDefinitions="Auto,*,Auto"
                      ColumnSpacing="16"
                      RowSpacing="16">

                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeThickness="0"
                            BackgroundColor="#F4F0FF"
                            WidthRequest="66"
                            HeightRequest="66"
                            Padding="8"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <ImageButton Source="{Binding EmoteOne.Image}"
                                     BackgroundColor="Transparent"
                                     Command="{Binding PlayAnimationCommand}"
                                     CommandParameter="{Binding EmoteOne}"
                                     Aspect="AspectFit"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2"
                            StrokeThickness="0"
                            BackgroundColor="#FFF7E8"
                            WidthRequest="66"
                            HeightRequest="66"
                            Padding="8"
                            HorizontalOptions="End"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <ImageButton Source="{Binding EmoteTwo.Image}"
                                     BackgroundColor="Transparent"
                                     Command="{Binding PlayAnimationCommand}"
                                     CommandParameter="{Binding EmoteTwo}"
                                     Aspect="AspectFit"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1"
                            StrokeThickness="0"
                            BackgroundColor="#F9F7FF"
                            Padding="10"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>
                        <Image x:Name="myPet"
                               Source="{Binding PetImage}"
                               Aspect="AspectFit"
                               WidthRequest="200"
                               HeightRequest="200"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0"
                            StrokeThickness="0"
                            BackgroundColor="#E9FFF4"
                            WidthRequest="66"
                            HeightRequest="66"
                            Padding="8"
                            HorizontalOptions="Start"
                            VerticalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <ImageButton Source="{Binding EmoteThree.Image}"
                                     BackgroundColor="Transparent"
                                     Command="{Binding PlayAnimationCommand}"
                                     CommandParameter="{Binding EmoteThree}"
                                     Aspect="AspectFit"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2"
                            StrokeThickness="0"
                            BackgroundColor="#FFF1EC"
                            WidthRequest="66"
                            HeightRequest="66"
                            Padding="8"
                            HorizontalOptions="End"
                            VerticalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <ImageButton Source="{Binding EmoteFour.Image}"
                                     BackgroundColor="Transparent"
                                     Command="{Binding PlayAnimationCommand}"
                                     CommandParameter="{Binding EmoteFour}"
                                     Aspect="AspectFit"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    StrokeThickness="0"
                    BackgroundColor="#FFFFFF"
                    Padding="14,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Label Text="Tap an emote to cheer up your companion and keep the momentum going."
                       FontSize="13"
                       TextColor="#6F6A84"
                       HorizontalOptions="Center"/>
            </Border>
        </Grid>
    </Grid>
</ContentPage>