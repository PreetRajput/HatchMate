<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pet"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,*" 
          RowSpacing="20" 
          Padding="20">

        <!-- Top Row: Pet Name (Center) and Level (Right) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" 
                   Text="{Binding PetName}" 
                   TextColor="Black"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <Label Grid.Column="1" 
                   Text="{Binding PetLevel, StringFormat='Level: {0}'}" 
                   TextColor="Black"
                   FontSize="18"
                   HorizontalOptions="End"
                   VerticalOptions="Center"
                   Margin="20,0,0,0"/>
        </Grid>

        <!-- Center Row: 4 Emotes as corners with Pet in center -->
        <Grid Grid.Row="1" 
              ColumnDefinitions="Auto,*,Auto" 
              RowDefinitions="Auto,*,Auto"
              ColumnSpacing="20"
              RowSpacing="20">

            <!-- Top Left Emote -->
            <ImageButton Grid.Row="0" 
                         Grid.Column="0"
                         Source="{Binding EmoteOne.Image}" 
                         WidthRequest="80" 
                         HeightRequest="80"
                         Command="{Binding PlayAnimationCommand}"
                         CommandParameter="{Binding EmoteOne}"
                         Aspect="AspectFit"
                         VerticalOptions="Start"
                         HorizontalOptions="Start"/>

            <!-- Top Right Emote -->
            <ImageButton Grid.Row="0" 
                         Grid.Column="2"
                         Source="{Binding EmoteTwo.Image}" 
                         WidthRequest="80" 
                         HeightRequest="80"
                         Command="{Binding PlayAnimationCommand}"
                         CommandParameter="{Binding EmoteTwo}"
                         Aspect="AspectFit"
                         VerticalOptions="Start"
                         HorizontalOptions="End"/>

            <!-- Center Pet Image -->
            <Image x:Name="myPet" 
                   Grid.Row="1" 
                   Grid.Column="1"
                   Source="{Binding PetImage}" 
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="200"
                   HeightRequest="200"/>

            <!-- Bottom Left Emote -->
            <ImageButton Grid.Row="2" 
                         Grid.Column="0"
                         Source="{Binding EmoteThree.Image}" 
                         WidthRequest="80" 
                         HeightRequest="80"
                         Command="{Binding PlayAnimationCommand}"
                         CommandParameter="{Binding EmoteThree}"
                         Aspect="AspectFit"
                         VerticalOptions="End"
                         HorizontalOptions="Start"/>

            <!-- Bottom Right Emote -->
            <ImageButton Grid.Row="2" 
                         Grid.Column="2"
                         Source="{Binding EmoteFour.Image}" 
                         WidthRequest="80" 
                         HeightRequest="80"
                         Command="{Binding PlayAnimationCommand}"
                         CommandParameter="{Binding EmoteFour}"
                         Aspect="AspectFit"
                         VerticalOptions="End"
                         HorizontalOptions="End"/>

        </Grid>

    </Grid>
</ContentPage>