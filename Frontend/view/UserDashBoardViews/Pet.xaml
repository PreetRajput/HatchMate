<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pet"
             BackgroundColor="White">
    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" >


        <Label Grid.Row="1" Grid.Column="1"/>


        <VerticalStackLayout Grid.Row="1">
            <ImageButton Source="{Binding EmoteOne}"/>
            <ImageButton Source="{Binding EmoteTwo}"/>
        </VerticalStackLayout>
        
        <VerticalStackLayout Grid.Row="1" Grid.Column="2">
            <ImageButton Source= "{Binding EmoteThree}"/>
            <ImageButton Source= "{Binding EmoteFour}"/>
        </VerticalStackLayout>

        <Image x:Name="Pet" Source="{Binding PetImage}"/>

    </Grid>
</ContentPage>