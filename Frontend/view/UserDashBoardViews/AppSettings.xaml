<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.AppSettings"
             BackgroundColor="#F6F4FF">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="#6B5BFF"
                Padding="24,50,24,26">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Settings"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Keep your pet care routine tidy and simple."
                           FontSize="13"
                           Opacity="0.9"
                           TextColor="White"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#FFF2D8"
                        Padding="12,10"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label Text="⚙️"
                           FontSize="18"
                           HorizontalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1"
                              Padding="20,24,20,20"
                              Spacing="16">

            <Label Text="ACCOUNT"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#8D87A8"
                   Margin="6,0,0,0"/>

            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,3"/>
                </Border.Shadow>

                <Grid Padding="18,16">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding logOutCommand}" />
                    </Grid.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                BackgroundColor="#FFEDE8"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="↪"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#FF7A59"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Log Out"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#2F2A45"/>
                            <Label Text="Sign out of your account"
                                   FontSize="12"
                                   TextColor="#8D87A8"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="22"
                               TextColor="#C7C2D8"
                               VerticalOptions="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Border StrokeThickness="0"
                    BackgroundColor="#F4F0FF"
                    Padding="16,14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Pet care note"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="#4B3F84"/>
                    <Label Text="A steady routine keeps your pet happy and your productivity rising."
                           FontSize="12"
                           TextColor="#6F6A84"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

    </Grid>

</ContentPage>